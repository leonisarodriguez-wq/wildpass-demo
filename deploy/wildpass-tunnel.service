# Cloudflare Quick Tunnel → http://127.0.0.1:3000. Its public *.trycloudflare.com address changes EVERY time
# this service (re)starts, so it deliberately has NO dependency on wildpass-app.service: restarting or updating
# the app never restarts the tunnel. While the app restarts, visitors briefly get an error page from Cloudflare.
[Unit]
Description=Cloudflare Quick Tunnel for Seguros Wildpass
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=leonisa_prueba
Group=leonisa_prueba
# Status page (with the current address at /quicktunnel) on localhost only.
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 --url http://127.0.0.1:3000
# Saves the public address to /var/lib/wildpass-tunnel/url (read by the `wildpass-url` command). "-" = never fail the tunnel over it.
ExecStartPost=-/usr/local/bin/wildpass-save-url
Restart=always
RestartSec=5
StateDirectory=wildpass-tunnel
StateDirectoryMode=0755

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
