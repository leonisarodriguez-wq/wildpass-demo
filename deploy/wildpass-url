#!/bin/sh
# Prints the public address of the Seguros Wildpass demo (Tailscale Funnel: fixed, https://wildpass.<tailnet>.ts.net).
url=$(tailscale funnel status 2>/dev/null | sed -n 's|^\(https://[^ ]*\) (Funnel on)$|\1|p' | head -n 1)
if [ -n "$url" ]; then
  echo "$url"
else
  echo "Funnel is not on. Check: tailscale funnel status (turn it on with: sudo tailscale funnel --bg 3000)" >&2
  exit 1
fi
