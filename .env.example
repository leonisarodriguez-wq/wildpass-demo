# Copy this file to .env and fill in real values. Never commit .env to Git.

# Brevo (https://www.brevo.com) → SMTP & API → API keys
BREVO_API_KEY=
# Must be a sender address verified in Brevo
SENDER_EMAIL=
SENDER_NAME=BRAND

# Optional: public address used in PDF/terms links (otherwise taken from the request)
PUBLIC_BASE_URL=

# Optional
HOST=127.0.0.1
PORT=3000
